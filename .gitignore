# RepliBuild-Hub — track only the manifest (replibuild.toml) and its verifier (test.jl).
# Everything below is regenerated by RepliBuild.build()/wrap() and must never be committed.

# Per-package build output (.so, .ll, .bc, DWARF) and generated Julia wrappers
build/
julia/

# Per-project incremental IR cache (mtime-keyed) + dependency graph
.replibuild_cache/

# llamacpp's harvested ggml-vulkan shader sources — 136 generated .cpp holding
# SPIR-V as byte arrays, plus their header. 206 MB, and regenerable from the
# pinned upstream tag by packages/llamacpp/harvest_vulkan_shaders.sh, so it is
# build input rather than tracked content — same class as build/ above. The
# generator itself is an upstream CMake ExternalProject the resolver cannot run;
# that script stands in for it.
packages/llamacpp/vulkan/

# onednn's harvested OpenCL kernel blobs — 92 generated .cpp holding each .cl
# kernel and gpu/intel header as a C string, plus ocl_kernel_list.cpp mapping
# kernel name -> blob. 1.4 MB, regenerated from the pinned tag by
# packages/onednn/harvest.jl. Same class as the shaders above: these come from
# a BUILD rule (per-file `cmake -P` custom commands), which is precisely what
# SysConfigGen cannot capture and says so.
#
# NOTE packages/onednn/config/ is deliberately NOT ignored: those three headers
# (dnnl_config.h, dnnl_version.h, dnnl_version_hash.h) are configure-step
# output and ARE committed, per the 2026-08-17 config-harvest rule and the
# curl/pcre2 config/ precedent. The blobs are mechanical translation of
# checked-in .cl files; the config encodes build DECISIONS that must be
# reviewable in a diff.
packages/onednn/ocl/

# micropython's harvested embed tree — upstream's ports/embed output (py/*.c,
# the generated genhdr/, the port glue), 3 MB, regenerated from the pinned tag
# and the committed packages/micropython/mpconfigport.h by
# packages/micropython/harvest_embed.sh. Same class as the shaders above: a
# build-time generator's output (MicroPython's qstr/module scan), not tracked
# content. The CONFIG it was generated under IS tracked, and embed/HARVEST.md
# records its sha256, which test.jl checks.
packages/micropython/embed/

# imgui writes imgui.ini next to the process cwd on exit — window positions,
# sizes and collapsed state from whoever last ran a demo. Runtime residue of a
# test run, not configuration.
imgui.ini

# JIT inspection artifacts — the MLIR module text the debugger uses as its source
# file, and the emitted object under REPLIBUILD_JIT_OBJDUMP. Written by the JIT on
# engine init and removed by RepliBuild.clean(), i.e. build output. The *.o here is
# already caught below, but the .mlir is not: without this rule the Hub picks up
# ~15MB of regenerable dumps (2.6MB from imgui alone).
.debug/

# Examples — the vendored RepliBuild output in lib/ (generated Box2d.jl wrapper,
# libbox2d.so, compilation_metadata.json, thunk_manifest.json) is regenerated by
# the wrap step and travels as a unit; never commit it. The hand-written layers —
# src/, test/, Project.toml, README.md — stay tracked.
examples/*/lib/

# Compiled objects / build artifacts, wherever they land
*.so
*.dylib
*.dll
*.a
*.o
*.ll
*.bc

# Generated wrapper metadata, if ever emitted outside build/ or lib/
compilation_metadata.json
thunk_manifest.json

# Example lockfiles — machine-local resolution (dev'd paths), same as LlamaChat's.
examples/*/Manifest.toml

# Claude Code session state and worktrees (nested git checkouts).
.claude/

# ════════════════════════════════════════════════════════════════════════════
# Beyond Julia and C/C++ — the Hub now also embeds JavaScript (quickjs),
# Python (micropython) and runs LLM chat tooling (LlamaChat). Rules for what
# those bring along.
# ════════════════════════════════════════════════════════════════════════════

# Secrets — never tracked, whatever the directory. Keys, certificates, env
# files and token/credential stores. (*.key also covers the IR cache's
# `<file>.ll.key` stamps, which live under build/ and are ignored anyway.)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
id_ecdsa*
.netrc
*.token
*secret*.json
*secrets*.toml
*credentials*
.npmrc
.pypirc

# Jinja — no template files and no Jinja engine are tracked. Chat templates
# come with the models (GGUF metadata / tokenizer_config.json) and the JS
# engine (@huggingface/jinja, MIT) is third-party code: both are fetched or
# copied into place locally, not committed. Includes LlamaChat's js/ folder,
# where vendor_js.sh expects jinja-<ver>.cjs and its licence.
*.jinja
*.jinja2
*.j2
*jinja*.cjs
*jinja*.mjs
*jinja*.js
jinja-LICENSE
examples/*/js/
*chat_template*
tokenizer_config.json

# Model weights and tensors — large, licensed separately, never in the Hub.
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.npz
*.npy

# JavaScript (quickjs) — npm installs, and compiled QuickJS bytecode that a
# test or example writes out (JS_WriteObject output; tied to one QuickJS
# release, see packages/quickjs/replibuild.toml).
node_modules/
package-lock.json
*.tgz
*.qjsbc
*.jsbc

# Python (micropython, harvest scripts) — interpreter caches and venvs, plus
# MicroPython's own build output: precompiled .mpy bytecode and embed.mk's
# scratch directory if a harvest is run in-tree.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
*.mpy
build-embed/
micropython_embed/

# Downloaded release archives (quickjs is an archive dependency; its tarball is
# fetched into .replibuild_cache, but a manual download should not be tracked).
*.tar
*.tar.gz
*.tar.xz
*.tar.bz2
*.tar.zst
*.zip

# Julia coverage/allocation output and machine-local preferences.
*.jl.cov
*.jl.*.cov
*.jl.mem
LocalPreferences.toml

# Logs, crash dumps, profiles.
*.log
core
core.[0-9]*
perf.data*

# Editors and OS.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
